<div id="<%= dom_id band %>">
<h1><%= @band.name %></h1>
<section class="band-gig-summary">
  <div>
    <h2>Past Gigs</h2>
    <table>
      <thead>
        <tr>
          <th>Client</th>
          <th>Fee</th>
        </tr>
      </thead>
      <tbody>
        <% @past_gigs.each do |gig| %>
          <tr>
            <td><%= link_to gig.client, gig_path(gig) %></td>
            <td><%= gig.fee.present? ? number_to_currency(gig.fee) : "" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @past_gigs.empty? %>
      <p>No past gigs yet.</p>
    <% end %>
    <p><%= link_to "All Past Gigs", past_gigs_path(band_id: @band.id), class: "button button--small" %></p>
  </div>

  <div>
    <h2>Upcoming Gigs</h2>
    <table>
      <thead>
        <tr>
          <th>Client</th>
          <th>Fee</th>
          <th>Load-in</th>
          <th>Start</th>
        </tr>
      </thead>
      <tbody>
        <% @upcoming_gigs.each do |gig| %>
          <tr>
            <td><%= link_to gig.client, gig_path(gig) %></td>
            <td><%= gig.fee.present? ? number_to_currency(gig.fee) : "" %></td>
            <td><%= gig.loadin&.strftime("%-I:%M %p") %></td>
            <td><%= gig.start&.strftime("%-I:%M %p") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @upcoming_gigs.empty? %>
      <p>No upcoming gigs booked.</p>
    <% end %>
    <p class="action-row">
      <%= link_to "All Upcoming Gigs", upcoming_gigs_path(band_id: @band.id), class: "button button--small" %>
      <%= link_to "Book a Gig", new_gig_path(band_id: @band.id), class: "button button--play" %>
    </p>
  </div>
</section>

<h2>Players</h2>
  <table>
    <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @players.each do |player| %>
      <tr>
        <td><%= player.first_name + " " + player.last_name %></td>
        <td><%= mail_to player.email %></td>
        <td></td>
      </tr>
    <% end %>
    <% @pending_invitations.each do |invitation| %>
      <tr>
        <td><em><%= invitation.invitee_name %></em></td>
        <td><em><%= mail_to invitation.invitee_email %></em></td>
        <td><span class="invitation-status">invitation sent on <%= invitation.created_at.strftime("%B %-d") %></span></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <p class="action-row">
    <%= link_to "Invite a new member", new_band_invitation_path(@band), class: "button" %>
  </p>
<h2>Songs</h2>
<p><%= @songs.length %> songs in <%= @lists.length %> set lists.</p>
<p><%= link_to "Song Details", songs_path(:band_id => @band.id) %></p>
<h2>Set Lists</h2>
<table data-controller="sortable-table">
  <thead>
    <tr>
      <th><button type="button" class="table-sort-button" data-action="sortable-table#sort" data-sortable-table-key-param="name">Name</button></th>
      <th>Songs</th>
      <th>Run Time</th>
      <th><button type="button" class="table-sort-button" data-action="sortable-table#sort" data-sortable-table-key-param="created">Created</button></th>
      <th><button type="button" class="table-sort-button" data-action="sortable-table#sort" data-sortable-table-key-param="updated">Updated</button></th>
      <th></th>
    </tr>
  </thead>
  <tbody data-sortable-table-target="body">
    <% @lists.each do |list| %>
      <tr data-name="<%= list.name.downcase %>" data-created="<%= list.created_at.to_i %>" data-updated="<%= list.updated_at.to_i %>">
        <td><%= link_to list.name, list_path(list) %></td>
        <td><%= list.songs.length %></td>
        <td><%= list.runtime_pretty %></td>
        <td><%= list.created_at.strftime("%b %-d, %Y") %></td>
        <td><%= list.updated_at.strftime("%b %-d, %Y") %></td>
        <td>
          <div class="table-actions">
            <%= link_to "Edit", edit_list_path(list), class: "button button--small" %>
            <%= button_to "Delete", list, method: :delete, class: "button button--small button--danger" %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<p class="action-row">
  <%= link_to "Create new set list", new_list_path(band_id: @band.id), class: "button button--play" %>
</p>
</div>
