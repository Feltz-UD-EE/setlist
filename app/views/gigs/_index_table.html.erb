<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Client</th>
      <th>Fee</th>
      <% unless past %>
        <th>Load-in</th>
        <th>Start</th>
      <% end %>
      <th>Booked By</th>
    </tr>
  </thead>
  <tbody>
    <% gigs.each do |gig| %>
      <tr>
        <td><%= gig.date.strftime("%b %-d, %Y") %></td>
        <td><%= link_to gig.client, gig_path(gig) %></td>
        <td><%= gig.fee.present? ? number_to_currency(gig.fee) : "" %></td>
        <% unless past %>
          <td><%= gig.loadin&.strftime("%-I:%M %p") %></td>
          <td><%= gig.start&.strftime("%-I:%M %p") %></td>
        <% end %>
        <td><%= gig.booked_by.formatted_name %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if gigs.empty? %>
  <p>No gigs to show.</p>
<% end %>
