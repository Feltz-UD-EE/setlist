<p style="color: green"><%= notice %></p>

<h1>Past Gigs</h1>

<%= render "index_table", gigs: @gigs, past: true %>

<p class="action-row">
  <% if @band.present? %>
    <%= link_to "Back to #{@band.name}", band_path(@band), class: "button" %>
  <% else %>
    <%= link_to "My Bands", bands_path, class: "button" %>
  <% end %>
</p>
