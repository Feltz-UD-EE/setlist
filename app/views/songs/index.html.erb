<p style="color: green"><%= notice %></p>

<h1><%= @title %></h1>

<table>
  <thead>
  <tr>
    <th>Title</th>
    <th>Performer</th>
    <th>Version</th>
    <th>Duration</th>
    <th>Intro</th>
    <th>Finish</th>
    <th>Sheets</th>
    <th>Set Lists</th>
  </tr>
  </thead>
  <tbody>
    <% @songs.each do |song| %>
      <tr>
        <td><%= link_to song.title, song_path(song) %></td>
        <td><%= song.performer %></td>
        <td><%= song.version %></td>
        <td><%= song.duration_pretty %></td>
        <td><%= song.intro %></td>
        <td><%= song.finish %></td>
        <td>
          <% if song.alternate_sheets? %>
            <span class="alternate-image-icon" title="Alternate instrument sheets">ALT</span>
          <% end %>
        </td>
        <td>
          <% setlist_entries = song.list_songs.select(&:list) %>
          <% if setlist_entries.any? %>
            <% setlist_entries.each do |list_song| %>
              <div>
                <%= link_to truncate(list_song.list.name, length: 20), list_path(list_song.list) %>
                - #<%= list_song.position %>
              </div>
            <% end %>
          <% else %>
            None
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @band.present? %>
  <%= link_to "New song", new_song_path(:band_id => @band.id) %>
<% else %>
  <%= link_to "New song", new_song_path %>
<% end %>
